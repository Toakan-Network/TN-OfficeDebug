<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>
    <!-- Enable CORS for Office Add-ins -->
    <httpProtocol>
      <customHeaders>
        <add name="Access-Control-Allow-Origin" value="*" />
        <add name="Access-Control-Allow-Methods" value="GET, POST, PUT, DELETE, OPTIONS" />
        <add name="Access-Control-Allow-Headers" value="Content-Type, Authorization, X-Requested-With" />
        <add name="Access-Control-Max-Age" value="86400" />
        
        <!-- Security headers for production -->
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-Frame-Options" value="ALLOWALL" />
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
        
        <!-- Cache headers for performance -->
        <add name="Cache-Control" value="public, max-age=3600" />
      </customHeaders>
    </httpProtocol>
    
    <!-- Office add-in optimized MIME types and security -->
    <staticContent>
      <!-- Office add-in specific MIME types -->
      <remove fileExtension=".json" />
      <mimeMap fileExtension=".json" mimeType="application/json" />
      <remove fileExtension=".xml" />
      <mimeMap fileExtension=".xml" mimeType="application/xml" />
      <remove fileExtension=".js" />
      <mimeMap fileExtension=".js" mimeType="application/javascript" />
    </staticContent>
    
    <!-- Default documents for deployment -->
    <defaultDocument>
      <files>
        <clear />
        <add value="taskpane.html" />
        <add value="index.html" />
      </files>
    </defaultDocument>
    
    <!-- Force HTTPS in production -->
    <rewrite>
      <rules>
        <rule name="Force HTTPS" stopProcessing="true">
          <match url=".*" />
          <conditions>
            <add input="{HTTPS}" pattern="off" ignoreCase="true" />
            <add input="{HTTP_HOST}" pattern="localhost" negate="true" />
          </conditions>
          <action type="Redirect" url="https://{HTTP_HOST}/{R:0}" redirectType="Permanent" />
        </rule>
      </rules>
    </rewrite>
    
    <!-- Performance: Enable compression -->
    <urlCompression doStaticCompression="true" doDynamicCompression="true" />
    
    <!-- Enable directory browsing for development only -->
    <directoryBrowse enabled="false" />
    
    <!-- Handle OPTIONS requests for CORS preflight -->
    <handlers>
      <add name="OptionsHandler" path="*" verb="OPTIONS" modules="ProtocolSupportModule" resourceType="Unspecified" requireAccess="None" />
    </handlers>
  </system.webServer>
  
  <!-- Handle errors gracefully -->
  <system.web>
    <httpRuntime enableVersionHeader="false" />
    <customErrors mode="Off" />
  </system.web>
</configuration>